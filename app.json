{
  "expo": {
    "name": "Bottle Track",
    "slug": "bottle-track",
    "scheme": "bottletrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "backgroundColor": "#0B1F44" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bottletrack.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Used to pick product images and your business logo."
      }
    },
    "android": {
      "package": "com.bottletrack.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1F44",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-sharing", "expo-image-picker", "./plugins/withAndroidReleaseSigning"]
  }
}
